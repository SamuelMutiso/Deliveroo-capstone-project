# Required. Generate each one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Everything below is optional and already has a working default.
# NEVER leave a key uncommented with nothing after the "=".
# An empty value overrides the default with "" and breaks the app.
# If you are not setting it, leave the "#" in place.

FLASK_ENV=development

# Leave commented for local SQLite. Set it for PostgreSQL.
#DATABASE_URL=postgresql://user:password@localhost:5432/deliveroo

#CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

#NOMINATIM_URL=https://nominatim.openstreetmap.org
#OSRM_URL=https://router.project-osrm.org
#GEO_COUNTRY_CODES=ke
#GEO_OFFLINE=0

# Set BREVO_API_KEY to send over HTTPS instead of SMTP.
# Required on hosts that block outbound SMTP ports, such as Render's free tier.
#BREVO_API_KEY=

# Mail is suppressed and logged unless MAIL_USERNAME or BREVO_API_KEY is set.
#MAIL_SERVER=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USE_TLS=1
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_DEFAULT_SENDER=Deliveroo <no-reply@deliveroo.co.ke>

# SMS falls back to a log line when unset.
#AT_ENV=sandbox
#AT_USERNAME=
#AT_API_KEY=
#AT_SENDER_ID=

# M-Pesa runs in simulation mode until the consumer key and secret are set.
#MPESA_ENV=sandbox
#MPESA_CONSUMER_KEY=
#MPESA_CONSUMER_SECRET=
#MPESA_SHORTCODE=174379
#MPESA_PASSKEY=
#MPESA_CALLBACK_URL=

#BASE_RATE_KES=180
#PRICE_PER_KM_KES=42

#DEMO_INBOX=you@gmail.com
